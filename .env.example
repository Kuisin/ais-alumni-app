# ---- App ----
APP_URL="https://ais.kai-lab.net"
AUTH_SECRET=""            # openssl rand -base64 32
AUTH_URL="https://ais.kai-lab.net"

# ---- Database: Supabase, region Northeast Asia (Tokyo) / ap-northeast-1 ----
# Runtime: Supavisor transaction pooler (port 6543) — suits serverless functions.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"
# Migrations: session pooler / direct connection (port 5432). Used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ---- Google OAuth ----
# Redirect URI: https://ais.kai-lab.net/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- LINE Login channel ----
# Callback URL: https://ais.kai-lab.net/api/auth/callback/line
# Link the "AIS Alumni Committee" Official Account as the channel's bot (same provider).
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""

# ---- LINE Messaging API channel (AIS Alumni Committee) ----
# Webhook URL: https://ais.kai-lab.net/api/line/webhook
LINE_MESSAGING_CHANNEL_ID=""
LINE_MESSAGING_CHANNEL_SECRET=""
# Optional: with ID + secret the app issues short-lived tokens itself.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=""
NEXT_PUBLIC_LINE_OA_ID=""   # e.g. @123abcde, for the "add friend" link

# ---- Email (Resend) — sending domain kai-lab.net, region Tokyo (ap-northeast-1) ----
RESEND_API_KEY=""
EMAIL_FROM="AIS Alumni <ais-alumni@kai-lab.net>"

# ---- Storage (Vercel Blob, private store, region Tokyo / hnd1) ----
BLOB_READ_WRITE_TOKEN=""

# ---- Cron ----
CRON_SECRET=""            # Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
